---
import Base from "~/layouts/Base.astro";
import RoomRandomizer from "~/components/RoomRandomizer.svelte";
---

<Base title="Room randomizer · random-tools" description="Randomly assign people to rooms, honoring capacity.">
  <main class="min-h-screen px-4 py-8 sm:py-12">
    <div class="mx-auto max-w-4xl">
      <a href="/random-tools/" class="text-muted hover:text-accent text-sm">← random-tools</a>
      <RoomRandomizer client:load />
    </div>
  </main>
</Base>
