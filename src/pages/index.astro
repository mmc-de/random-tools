---
import Base from "~/layouts/Base.astro";

const tools = [
  {
    href: "/random-tools/room-randomizer/",
    title: "Room randomizer",
    description: "Assign a list of people to rooms, randomly, honoring capacity.",
  },
  {
    href: "/random-tools/draw/",
    title: "Bucket draw",
    description: "Pick one option from a bucket. With or without replacement.",
  },
];
---

<Base title="random-tools">
  <main class="min-h-screen px-4 py-12 sm:py-16">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-3xl font-semibold tracking-tight">random-tools</h1>
      <p class="text-muted mt-2 text-base sm:text-lg">
        Two tiny tools. No accounts. No tracking. Works offline once loaded.
      </p>

      <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          tools.map((tool) => (
            <a
              href={tool.href}
              class="group border-border rounded-xl border p-6 transition-colors hover:border-accent"
            >
              <h2 class="text-xl font-semibold">{tool.title}</h2>
              <p class="text-muted mt-1 text-sm">{tool.description}</p>
              <span class="text-accent mt-4 inline-block text-sm font-medium">
                Open →
              </span>
            </a>
          ))
        }
      </div>

      <footer class="text-muted mt-12 text-xs">
        Built with Astro + Svelte. State stays in your browser.
      </footer>
    </div>
  </main>
</Base>
