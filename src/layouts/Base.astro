---
import "~/styles/global.css";
import ThemeToggle from "~/components/ThemeToggle.svelte";
import LanguageToggle from "~/components/LanguageToggle.svelte";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "random-tools",
  description = "Two tiny random-assignment tools.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    {/* Runs synchronously in <head> so data-theme + initial language are
        set BEFORE body paints. Using is:inline to bypass Astro's default
        module/async wrapping. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("random-tools:theme");
          var theme =
            stored === "dark" || stored === "light"
              ? stored
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.setAttribute("data-theme", theme);

          // Prime the language before components mount so the first paint
          // already shows the right strings (no EN→DE flash).
          var storedLang = localStorage.getItem("random-tools:lang");
          var lang = storedLang === "de" || storedLang === "en"
            ? storedLang
            : (navigator.language || "en").toLowerCase().startsWith("de")
              ? "de"
              : "en";
          document.documentElement.setAttribute("data-lang", lang);
        } catch (_) {
          /* localStorage may be blocked (private mode); fall through
             to the CSS @media (prefers-color-scheme) default. */
        }
      })();
    </script>
  </head>
  <body class="bg-bg text-fg font-body">
    <slot />
    <div class="topbar-slot">
      <LanguageToggle client:load />
      <ThemeToggle client:load />
    </div>
    <style>
      .topbar-slot {
        position: fixed;
        top: max(1rem, env(safe-area-inset-top));
        right: max(1rem, env(safe-area-inset-right));
        z-index: 60;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
    </style>
  </body>
</html>